# Local development configuration
# Copy to .env and fill in local credentials.

# Cloudflare KV
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_TIMEOUT=5s

# Local backend database tunnel
# The backend runs inside Docker and reaches host SSH forwarding through host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=15432
DB_NAME=revieu
DB_USER=revieu
DB_PASSWORD=

# Optional: override scripts/dev-db defaults
# REVIEU_DB_SSH_TARGET=CC
# REVIEU_DB_LOCAL_HOST=0.0.0.0
# REVIEU_DB_LOCAL_PORT=15432
# REVIEU_DB_REMOTE_FORWARD_PORT=15432
