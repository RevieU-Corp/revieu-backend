#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
RUNTIME_DIR="$ROOT_DIR/.runtime"
PID_FILE="$RUNTIME_DIR/dev-db-tunnel.pid"
LOG_FILE="$RUNTIME_DIR/dev-db-tunnel.log"

SSH_TARGET=${REVIEU_DB_SSH_TARGET:-CC}
LOCAL_HOST=${REVIEU_DB_LOCAL_HOST:-127.0.0.1}
LOCAL_PORT=${REVIEU_DB_LOCAL_PORT:-15432}
REMOTE_HOST=${REVIEU_DB_REMOTE_HOST:-revieu-postgres.revieu-dev.svc.cluster.local}
REMOTE_PORT=${REVIEU_DB_REMOTE_PORT:-5432}

usage() {
  cat <<EOF
Usage: $0 {up|down|status|restart}

Environment overrides:
  REVIEU_DB_SSH_TARGET  SSH host alias (default: CC)
  REVIEU_DB_LOCAL_HOST  Local bind address (default: 127.0.0.1)
  REVIEU_DB_LOCAL_PORT  Local port (default: 15432)
  REVIEU_DB_REMOTE_HOST Cluster PostgreSQL DNS (default: $REMOTE_HOST)
  REVIEU_DB_REMOTE_PORT Cluster PostgreSQL port (default: 5432)
EOF
}

pid() {
  [[ -f "$PID_FILE" ]] && cat "$PID_FILE" || true
}

is_running() {
  local current_pid
  current_pid=$(pid)
  [[ -n "$current_pid" ]] && kill -0 "$current_pid" 2>/dev/null
}

port_is_open() {
  nc -z "$LOCAL_HOST" "$LOCAL_PORT" >/dev/null 2>&1
}

status() {
  if is_running; then
    echo "database tunnel running (pid $(pid), $LOCAL_HOST:$LOCAL_PORT)"
  elif port_is_open; then
    echo "database tunnel port occupied by another process ($LOCAL_HOST:$LOCAL_PORT)"
    return 1
  else
    echo "database tunnel stopped"
    return 1
  fi
}

up() {
  if is_running; then
    status
    return 0
  fi

  if port_is_open; then
    echo "error: $LOCAL_HOST:$LOCAL_PORT already in use" >&2
    exit 1
  fi

  mkdir -p "$RUNTIME_DIR"
  rm -f "$PID_FILE"

  ssh \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o BatchMode=yes \
    -N \
    -L "$LOCAL_HOST:$LOCAL_PORT:$REMOTE_HOST:$REMOTE_PORT" \
    "$SSH_TARGET" >"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  for _ in {1..20}; do
    if ! is_running; then
      echo "error: SSH tunnel failed; see $LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    if port_is_open; then
      status
      return 0
    fi
    sleep 0.25
done

  echo "error: tunnel did not open $LOCAL_HOST:$LOCAL_PORT; see $LOG_FILE" >&2
  kill "$(pid)" 2>/dev/null || true
  rm -f "$PID_FILE"
  exit 1
}

down() {
  if is_running; then
    kill "$(pid)" 2>/dev/null || true
    for _ in {1..20}; do
      is_running || break
      sleep 0.25
    done
    echo "database tunnel stopped"
  else
    echo "database tunnel already stopped"
  fi
  rm -f "$PID_FILE"
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  status) status ;;
  restart) down; up ;;
  *) usage; exit 2 ;;
esac
